# ─── Credora FE — environment ───────────────────────────────────────────
# The app runs on mock data with NONE of these (sources default to "mock").
# Flip to live by copying these into .env.local.

# Source switches (independent)
NEXT_PUBLIC_READ_SOURCE=api         # mock | api    — reads from mock or the deployed backend
NEXT_PUBLIC_WRITE_SOURCE=mock       # mock | chain  — writes faked or sent to Mantle

# Credora-Backend (deployed, MongoDB-backed). Used by the /api/credora proxy.
CREDORA_API=https://credora.fabian.web.id
NEXT_PUBLIC_CREDORA_API=https://credora.fabian.web.id

# Mantle Sepolia
NEXT_PUBLIC_MANTLE_RPC_URL=https://rpc.sepolia.mantle.xyz
NEXT_PUBLIC_MANTLE_CHAIN_ID=5003

# Deployed + verified contract addresses (Mantle Sepolia)
NEXT_PUBLIC_AGENT_PASSPORT=0x40A9cB62D2a02189be10eC4657ae02B2c235174e
NEXT_PUBLIC_SEASON_MANAGER=0xC425c96B30BF8a9190E7A273D990a6a8B6F49C3b
NEXT_PUBLIC_DECISION_LOGGER=0x2dFf6D5eB709b368df0c11bd80209eB92591658c
NEXT_PUBLIC_OUTCOME_REGISTRY=0x67479A2F63ecAc78fb52D696df7D7455e2347983
NEXT_PUBLIC_REPUTATION_ENGINE=0xc84D1e8FECaDa44487242E5D855AEE7F752A12EA

# NOTE: the FE never needs MongoDB credentials — those live only in the
# backend's Vercel env. Do not put DB secrets in this repo.
